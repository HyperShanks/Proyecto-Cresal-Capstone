# ==========================================
# 🗄️ BASE DE DATOS (PostgreSQL / Supabase)
# ==========================================
# Cadena de conexión principal. En producción/evaluación usar formato estándar con SSL.
# Formato: postgresql://<usuario>:<password>@<host>:<puerto>/<nombre_db>
DATABASE_URL="postgresql://postgres:TU_PASSWORD_AQUI@localhost:5432/cresal_db"

# ==========================================
# 🔐 AUTENTICACIÓN / JWT
# ==========================================
# Clave secreta para firma y verificación de tokens HS256 (mínimo 32 caracteres hexadecimales)
JWT_SECRET_KEY="tu_clave_secreta_jwt_de_al_menos_32_caracteres_hexadecimales"
TOKEN_EXPIRE_MINUTES=1440
ALGORITHM="HS256"

# ==========================================
# ☁️ SUPABASE (Storage Multimedia / Imágenes)
# ==========================================
# URL y llave API de tu proyecto en Supabase (Storage de fotografías de repuestos)
SUPABASE_URL="https://tu-proyecto.supabase.co"
SUPABASE_KEY="tu_supabase_service_role_o_anon_key"

# ==========================================
# 🤖 NOTIFICACIONES Y ALERTAS (Telegram Bot)
# ==========================================
# Token provisto por @BotFather e ID del canal o chat de destino para alertas gerenciales
TELEGRAM_BOT_TOKEN="123456789:ABCdefGHIjklMNOpqrsTUVwxyz"
TELEGRAM_GERENCIA_CHAT_ID="-1001234567890"
TELEGRAM_ENABLED=false

# ==========================================
# 🔍 GOOGLE CLOUD VISION (OCR Inteligente)
# ==========================================
# Ruta relativa o absoluta hacia el archivo JSON de credenciales de Service Account
GOOGLE_APPLICATION_CREDENTIALS="vision-key.json"

# ==========================================
# 🚀 ACTUALIZACIONES AUTOMÁTICAS (OTA GitHub)
# ==========================================
GITHUB_REPO_OWNER="FelipeCSDav"
GITHUB_REPO_NAME="CresalRepoCapstone"
# Token opcional para consultar releases privados o evitar rate limits en GitHub API
GITHUB_RELEASE_TOKEN=""

# ==========================================
# ⚙️ POLÍTICAS Y TESTING LOCAL
# ==========================================
# Permite saltarse la restricción de horario operativo (08:30 - 18:30) durante pruebas locales
BYPASS_HORARIO_OPERATIVO=true
